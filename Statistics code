"""Generate all manuscript figures for: 
Integrating adaptation into climate risk models using agent-based modelling: a systematic literature review

Author: Ruth Williams
Year: 2026

Edit BASE_DIR, EXCEL_FILENAME and OUTPUT_FOLDER below, then run this script.
Each figure is generated by a separate function.
"""
# =====================================================
# Imports
# =====================================================

from pathlib import Path
import pandas as pd
import statsmodels.api as sm
from scipy.stats import fisher_exact

# =====================================================
# User settings
# =====================================================

BASE_DIR = Path(r"_file_")

EXCEL_FILENAME = "Statistical summaries.xlsx"
OUTPUT_FOLDER = "results"

# =====================================================
# Paths
# =====================================================

EXCEL_FILE = BASE_DIR / EXCEL_FILENAME
OUTPUT_DIR = BASE_DIR / OUTPUT_FOLDER

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# =====================================================
#SHEETS
# =====================================================
temporal_sheet = "Temporal analysis"
fisher_sheet = "Fisher test"

# =====================================================
# Load workbook
# =====================================================

workbook = pd.ExcelFile(EXCEL_FILE)

# =====================================================
# Weighted regression analysis
# =====================================================

def run_temporal_trend_analysis():

    df = pd.read_excel(
        workbook,
        sheet_name=temporal_sheet)

    # Keep only years from 2010 onwards
    df = df[df["Year"] >= 2010].copy()

    variables = {
        "Calibration": "Calibration %",
        "Validation": "Validation %",
        "Participatory modelling": "PM %",
        "Dynamic adaptation": "Dynamic %"}

    results = []

    print("\n" + "=" * 60)
    print("Temporal trend analysis")
    print("=" * 60)

    for name, col in variables.items():

        X = sm.add_constant(df["Year"])

        model = sm.WLS(
            df[col],
            X,
            weights=df["Total papers"]
        ).fit()

        slope = model.params["Year"]
        p_value = model.pvalues["Year"]
        r_squared = model.rsquared

        results.append({
            "Variable": name,
            "Slope": slope,
            "P-value": p_value,
            "R²": r_squared})

        print(f"\n{name}")
        print(f"Slope = {slope:.4f}")
        print(f"P-value = {p_value:.4f}")
        print(f"R² = {r_squared:.3f}")

    return pd.DataFrame(results)
# =====================================================
# Fisher's exact test
# =====================================================

def run_fisher_tests():
    df = pd.read_excel(
        workbook,
        sheet_name=fisher_sheet)

    results = []

    print("\n" + "=" * 60)
    print("Fisher Exact Tests")
    print("=" * 60)

    for _, row in df.iterrows():

        table = [
            [row["PM yes"], row["PM no"]],
            [row["No-PM yes"], row["No-PM no"]]]

        oddsratio, pvalue = fisher_exact(
            table,
            alternative="two-sided")

        results.append({
            "Variable": row["Variable"],
            "Odds ratio": oddsratio,
            "P-value": pvalue})

        print(f"\n{row['Variable']}")
        print(f"Odds ratio = {oddsratio:.3f}")
        print(f"P-value = {pvalue:.4f}")

    return pd.DataFrame(results)

# =====================================================
# Save results
# =====================================================

def run_all_statistics():

    temporal_results = run_temporal_trend_analysis()
    fisher_results = run_fisher_tests()

    output_file = OUTPUT_DIR / "statistical_results.xlsx"

    with pd.ExcelWriter(output_file) as writer:

        temporal_results.to_excel(
            writer,
            sheet_name="Temporal trends",
            index=False)

        fisher_results.to_excel(
            writer,
            sheet_name="Fisher tests",
            index=False)

    print(f"\nResults saved to: {output_file}")

# =====================================================
# Main
# =====================================================

if __name__ == "__main__":
    run_all_statistics()
