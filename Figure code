    # 2. Region sector stacked bar (top-right)
    regions  = df_region_sector.iloc[:, 0].astype(str)
    sectors  = df_region_sector.columns[1:]          # columns B → M
    x        = np.arange(len(regions))

    # Build a colour palette for up to 12 sectors
    sector_colours = {
        "Agriculture and land use":        "#1a3a1a",
        "Coastal and ocean management":    "#2d6a2d",
        "Water management":                "#4caf4c",
        "Disaster risk management":        "#a8d5a8",
        "Infrastructure and transport":    "#5c1a00",
        "Industry":                        "#c0392b",
        "Finance":                         "#e8836e",
        "Energy":                          "#f5c4b8",
        "Health":                          "#3b0a45",
        "Indigenous Culture":              "#7b2d8b",
        "Tourism":                         "#d966e0",
        "Historical populations":          "#f0b8f5",
    }
    # Fallback grey for any unexpected sector names
    default_colour = "#aaaaaa"

    bottoms = np.zeros(len(regions))

    for i, sector in enumerate(sectors):
        values = df_region_sector[sector].fillna(0).values
        colour = sector_colours.get(sector, default_colour)
        ax2.bar(x, values, bottom=bottoms,
                label=sector, color=colour)
        bottoms += values

    # Replace specific labels with line breaks
    regions = regions.replace({
        "Central and South America": "Central and\nSouth America",
        "North America": "North\nAmerica",  # optional
    })

    ax2.set_xticks(x)
    ax2.set_xticklabels(regions, rotation=90, ha="center", fontsize=label_size - 1)
    ax2.set_xlabel("Region", fontsize=label_size)
    ax2.set_ylabel("Article Count", fontsize=label_size)
