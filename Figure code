def plot_adaptation_strategy_count():
    data = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["strategy_count"])

    #Columns to plot
    x = data["Strategy count"].to_numpy()
    y = data["Frequency"].to_numpy()

    # Weighted mean of x by its frequencies
    x_mean = np.average(x, weights=y)

    fig, ax = plt.subplots(figsize=(8, 6))
    bars = ax.bar(x, y, color="#1B6B8A")

    ax.set_xticks(x)

    # Replace '10' with '10+'
    labels = ax.get_xticklabels()
    labels[-1].set_text("10+")
    ax.set_xticklabels(labels)

    # Add mean annotation in upper-right corner
    ax.text(
        0.97, 0.95,
        f"Mean = {x_mean:.0f} strategies",
        transform=ax.transAxes,
        ha="right",
        va="top",
        fontsize=12,
        color="black")

    plt.ylabel('Article count')
    ax.set_ylim(0, 30)
    plt.xlabel('Strategy count')

    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)
    save_figure("adaptation_count_chart")

def plot_four_panel_summary():
    df_sector = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["sector"])

    df_region_sector = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["region_sector"])

    df_scale = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["scale"])

    df_climate = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["climate_risk"])

    # Figure layout
    fig, axes = plt.subplots(2, 2, figsize=(18, 14))
    fig.subplots_adjust(hspace=0.6, wspace=0.35)

    # Define all axes upfront
    ax1, ax2, ax3, ax4 = axes[0, 0], axes[0, 1], axes[1, 0], axes[1, 1]

    # Add panel labels
    ax1.text(-0.1, 1.05, "A", transform=ax1.transAxes,
             fontsize=16, fontweight="bold", va="top")

    ax2.text(-0.1, 1.05, "B", transform=ax2.transAxes,
             fontsize=16, fontweight="bold", va="top")

    ax3.text(-0.1, 1.05, "C", transform=ax3.transAxes,
             fontsize=16, fontweight="bold", va="top")

    ax4.text(-0.1, 1.05, "D", transform=ax4.transAxes,
             fontsize=16, fontweight="bold", va="top")

    teal       = "#1B6B8A"
    label_size = 16
    title_size = 13

    # 1.Sector  (top-left)
    categories = df_sector.iloc[:, 0].astype(str)
    counts      = df_sector.iloc[:, 1]
    # Replace specific labels with line breaks
    categories = categories.replace({
        "Agriculture and land use": "Agriculture and\nland use",
        "Coastal and ocean management": "Coastal and\nocean management",
        "Disaster risk management": "Disaster risk\nmanagement",
        "Infrastructure and transport": "Infrastructure and\ntransport",
        "Historical populations": "Historical\npopulations"})

    x_pos = range(len(categories))
    ax1.bar(x_pos, counts, color=teal)
    ax1.set_xticks(x_pos)
    ax1.set_xticklabels(categories, rotation=90, ha="center", fontsize=label_size - 1)
    ax1.set_xlabel("Sector", fontsize=label_size)
    ax1.set_ylabel("Article Count", fontsize=label_size)
    #ax1.set_title("Sector", fontsize=title_size, fontweight="bold")
