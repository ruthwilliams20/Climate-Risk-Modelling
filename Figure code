    b2 = ax4.bar(x4, variable, width=w, bottom=base,
                 color=colour_variable, hatch="----", edgecolor="white",
                 label="Precipitation (variable)")
    b3 = ax4.bar(x4, drought, width=w, bottom=base + variable,
                 color=colour_drought, hatch="////", edgecolor="white",
                 label="Precipitation (drought)")
    b4 = ax4.bar(x4, flooding, width=w, bottom=base + variable + drought,
                 color=teal, hatch="....", edgecolor="white",
                 label="Precipitation (flooding)")

    ax4.set_xticks(x4)
    ax4.set_xticklabels(labels, rotation=90, ha="center", fontsize=label_size - 1)
    ax4.set_xlabel("Climate hazard modelled", fontsize=label_size)
    ax4.set_ylabel("Article count", fontsize=label_size)
    #ax4.set_title("Climate Risk", fontsize=title_size, fontweight="bold")
    ax4.tick_params(axis="y", labelsize=label_size - 1)

    ax4.legend(fontsize=label_size - 2, loc="upper right")

