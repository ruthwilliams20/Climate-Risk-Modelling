        ax.set_xlabel("Publication year")

    # Remove top-row x labels
    for ax in axes[0]:
        ax.set_xlabel("")

    save_figure("temporal_trends")
    
def plot_climate_scenario_donut():
    scenario_df = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["scenario"],
        keep_default_na=False)

    counts = dict(
        zip(
            scenario_df["Scenario type"],
            scenario_df["Count"] ))

    metric_df = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["climate_metric"])

    uses_subtypes = dict(
        zip(
            metric_df["Climate metric"],
            metric_df["Count"]))

    # Totals
    total = scenario_df["Count"].sum()

    scenario_total = (
        scenario_df.loc[
            scenario_df["Scenario type"] != "None",
            "Count"
        ].sum())
    # Base colour palette 
    col_none  = '#bdbdbd'
    col_base  = '#dcdcff'  
    col_types = {
        'RCP or SSP':        '#0072B2',
        'Temperature':    '#E69F00',
        'Precipitation':  '#D55E00',
        'Extreme events': '#CC79A7',
        'Other':          '#009E73'}

    col_uses_outer = {
        'Average': '#9ecae1',   # light blue
        'Extreme': '#56B4E9'    # darker blue}

    # Order outer ring by % of scenario users
    type_items = [(k, counts[k], col_types[k]) for k in ['RCP or SSP','Temperature','Precipitation','Extreme events','Other']]
    type_items.sort(key=lambda x: x[1], reverse=True) 

    types_sorted        = [t for t, c, col in type_items]
    type_counts_sorted  = [c for t, c, col in type_items]
    col_types_sorted    = [col for t, c, col in type_items]

    # Figure
    plt.rcParams.update({'axes.titlesize': 13, 'font.size': 10})
    fig, ax = plt.subplots(figsize=(9.6, 6.6), constrained_layout=True)  # a bit wider to fit the legend
    ax.set(aspect='equal')
    start_angle = 90

    # Outer ring
    # Include a transparent wedge for the "None" arc so types only span the "Uses" arc.
    outer_sizes  = [counts['None']] + type_counts_sorted
    outer_colors = [(1,1,1,0)] + col_types_sorted
    outer_wedges = ax.pie(
        outer_sizes, radius=1.00, startangle=start_angle,
        colors=outer_colors,
        wedgeprops=dict(width=0.28, edgecolor='white', linewidth=1)
    )[0]

    #Third ring: Uses scenarios breakdown

    # Transparent wedge for "No scenarios" so this ring only wraps "Uses scenarios"
    uses_outer_sizes = [counts['None']] + list(uses_subtypes.values())
    uses_outer_colors = [(1, 1, 1, 0)] + [col_uses_outer[k] for k in uses_subtypes]

    uses_outer_wedges = ax.pie(
        uses_outer_sizes,
        radius=1.22,
        startangle=start_angle,
        colors=uses_outer_colors,
        wedgeprops=dict(width=0.22, edgecolor='white', linewidth=1)
    )[0]

    # Inner ring
    inner_sizes  = [counts['None'], scenario_total]
    inner_colors = [col_none, col_base]
    inner_wedges = ax.pie(
        inner_sizes, radius=0.70, startangle=start_angle,
        colors=inner_colors,
        wedgeprops=dict(width=0.28, edgecolor='white', linewidth=1)
    )[0]

    # Central percent
    pct_uses = scenario_total / total
    ax.text(0, 0.03, f"{pct_uses*100:.0f}%", ha='center', va='center', fontsize=18, weight='bold')
    ax.text(0, -0.10, "use multiple scenarios", ha='center', va='center', fontsize=10)

    # Inner labels (wrapped) placed inside the ring
    inner_labels_wrapped = ['Single\nscenario', 'Multiple\nclimate\nscenarios']
    inner_pct = [counts['None']/total, scenario_total/total]

    r_label = 0.55   # baseline radius for label (line 1)
    r_pct   = 0.49   # (if you re-enable the percent line)

    # Fine-tune just the "Uses scenarios" label
    R_INWARD_SHIFT = 0.03   # pull inward (reduce radius) for Uses
    X_LEFT_SHIFT   = 0.03   # shift left in x for Uses

    for w, lab, p in zip(inner_wedges, inner_labels_wrapped, inner_pct):
        ang = (w.theta2 + w.theta1) / 2.0
        x = np.cos(np.deg2rad(ang)); y = np.sin(np.deg2rad(ang))

        r_here = r_label
        x_here = r_label * x
        y_here = r_label * y

        # Apply adjustments only to "Uses scenarios"
        if lab.startswith('Uses'):
            r_here = r_label - R_INWARD_SHIFT
            x_here = r_here * x - X_LEFT_SHIFT 
            y_here = r_here * y

        ax.text(x_here, y_here, lab,
                ha='center', va='center', fontsize=10, linespacing=0.95)

    # Outer wedge labels = % of scenario users (on-wedge)
    type_wedges = outer_wedges[1:]  # skip transparent "None"
    r_outer_label = 0.86
    for w, (t, c, col) in zip(type_wedges, type_items):
        ang = (w.theta2 + w.theta1) / 2.0
        x = np.cos(np.deg2rad(ang)); y = np.sin(np.deg2rad(ang))
        pct_of_users = c / scenario_total
        ax.text(r_outer_label * x, r_outer_label * y,
                f"{pct_of_users*100:.0f}%", ha='center', va='center',
                fontsize=10, color='white', weight='bold')

    # Labels for third ring (% within Uses scenarios)
    uses_outer_label_r = 1.12

    for w, (lab, val) in zip(uses_outer_wedges[1:], uses_subtypes.items()):
        ang = (w.theta2 + w.theta1) / 2
        x = np.cos(np.deg2rad(ang))
        y = np.sin(np.deg2rad(ang))
        pct = val / scenario_total

        ax.text(
            uses_outer_label_r * x,
            uses_outer_label_r * y,
            f"{pct*100:.0f}%",
            ha='center', va='center',
            fontsize=10, weight='bold', color='white')

    # Legend
    handles = [Line2D([0],[0], marker='o', color='w', markerfacecolor=col,
                       markersize=8, label=f"{t} ({c})")
               for (t, c, col) in type_items]
    # Make space on the right so the legend doesn't overlap
    plt.subplots_adjust(right=0.80)
    fig.legend(handles=handles, loc='center left', bbox_to_anchor=(0.82, 0.5),
               frameon=False, title="Scenario types")

    # Second legend: Uses-scenario breakdown
    uses_handles = [
        Line2D([0], [0],
               marker='o',
               color='w',
               markerfacecolor=col_uses_outer[k],
               markersize=8,
               label=f"{k} ({v})")
        for k, v in uses_subtypes.items()]

    fig.legend(
        handles=uses_handles,
        loc='center left',
        bbox_to_anchor=(0.82, 0.32),
        frameon=False,
        title='Climate metric')

    save_figure("climate_scenario")

