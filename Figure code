def plot_adaptation_type():
    data = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["adaptation_type"])

    # Columns to plot
    x = data["Adaptation type"]
    y = data["Count"]

    # Wrap long labels
    wrapped_labels = [textwrap.fill(str(label), width=15) for label in x]

    # Create bar chart
    plt.figure(figsize=(8, 6))
    plt.bar(x, y, color="#1B6B8A")
    plt.ylabel("Article count")
    plt.xlabel("Adaptation type")
    plt.xticks(ticks=x,
               labels=wrapped_labels,
               rotation=90,
               ha="center")

    # Clean up spines
    ax = plt.gca()
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

    save_figure("adaptation_type")

def plot_region():
