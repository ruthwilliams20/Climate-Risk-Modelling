def save_figure(
    filename,
    dpi=FIG_DPI,
    pdf=False
):
    plt.tight_layout()
    plt.savefig(
        OUTPUT_DIR / f"{filename}.png",
        dpi=dpi,
        bbox_inches="tight"
    )
    if pdf:
        plt.savefig(
            OUTPUT_DIR / f"{filename}.pdf",
            bbox_inches="tight")
    if SHOW_PLOTS:
        plt.show()
    else:
        plt.close()
  
