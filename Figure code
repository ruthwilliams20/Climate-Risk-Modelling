        replacements = {
            "ocean and coastal": "Ocean and\ncoastal",
            "biophysical and ecological": "Biophysical and\necological",
            "theoretical climate hazard": "Theoretical\nclimate hazard"}
        return replacements.get(label.strip().lower(), label)

