def plot_evaluation_methods():
    df = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["evaluation"])

    TOTAL_PAPERS = round(
        df["Count"].iloc[0] /
        (df["Percent"].iloc[0] / 100))

    #Compute counts
    df["Yes (count)"] = df["Count"]
    df["No (count)"] = TOTAL_PAPERS - df["Count"]

    # Sort so bars read top→bottom in natural order (optional)
    df = df.sort_values("Yes (count)", ascending=True)

    # Plot
    fig, ax = plt.subplots(figsize=(7, 4))
    y = range(len(df))

    # Yes first, closest to y-axis
    ax.barh(y, df["Yes (count)"], color="#2b8cbe", label="Yes")

    # No second, stacked to the right
    ax.barh(y, df["No (count)"], left=df["Yes (count)"], color="#d3d3d3", label="No")

    # Labels
    ax.set_yticks(y, df["Evaluation"])
    ax.set_xlim(0, TOTAL_PAPERS)
    ax.set_xlabel("Article count")
    ax.set_ylabel("Evaluation method")
    #ax.set_title("Evaluation Techniques Used (Yes vs No, 100% Stacked)")

    # Embedded percentage labels
    for i, (yes_v, no_v) in enumerate(zip(df["Yes (count)"], df["No (count)"])):
        # Yes label
        if yes_v >= 5:
            ax.text(yes_v/2, i, f"{yes_v}", ha="center", va="center", color="white", fontsize=10)
        # No label
        if no_v >= 5:
            ax.text(yes_v + no_v/2, i, f"{no_v}", ha="center", va="center", color="black", fontsize=10)


    #Legend outside in a boxed panel
    legend = ax.legend(
        title="Evaluation present?",
        title_fontsize=11,
        fontsize=10,
        loc="center left",           
        bbox_to_anchor=(1.02, 0.5),
        frameon=True,
        fancybox=True,
        edgecolor="#888888",)
    ax.grid(axis="x", linestyle="--", alpha=0.35)

    save_figure("evaluation_chart")

def plot_temporal_trends():
    df = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["temporal_analysis"])
    START_YEAR = 2010  # change to if desired

    # Keep only years of interest
    df = df[df["Year"] >= START_YEAR].copy()

    # Column names
    cal_col = "Calibration %"
    val_col = "Validation %"
    pm_col = "PM %"
    dyn_col = "Dynamic %"

    # Plot style
    sns.set_style("whitegrid")
    plt.rcParams["figure.dpi"] = 300

    # CREATE PANELS
    fig, axes = plt.subplots(
        2, 2,
        figsize=(12, 8),
        sharex=True,
        sharey=True)

    plots = [
        (cal_col, "Calibration", axes[0, 0]),
        (val_col, "Validation", axes[0, 1]),
        (pm_col, "Participatory modelling", axes[1, 0]),
        (dyn_col, "Dynamic behaviour", axes[1, 1])]

    for col, title, ax in plots:

        # Scatter points
        ax.scatter(
            df["Year"],
            df[col],
            facecolors="white",  
            edgecolors="black",
            linewidth=1.2,
            s=90,
            zorder=3)

        # Linear trend line
        sns.regplot(
            x="Year",
            y=col,
            data=df,
            scatter=False,
            ci=None,
            color="black",
            line_kws={
                "linestyle": "--",
                "linewidth": 2
