        zip(
            eval_df["Evaluation"].str.lower(),
            eval_df["Non-participatory"]))

    # Overall counts (for the "Overall" category)
    k_overall_part = n_part
    k_overall_non  = n_non

    # X-axis order: move "Overall" to the start
    metrics = ['overall', 'sensitivity', 'calibration', 'validation']
    labels  = ['Overall', 'Sensitivity', 'Calibration', 'Validation']

    # Colors (blue = non-participatory, red = participatory)
    col_non = '#56B4E9'
    col_par = '#D55E00'

    # Helper: proportion + Wilson 95% CI
    def prop_and_ci(k, n, alpha=0.05, method='wilson'):
        p = k / n
        lo, hi = proportion_confint(k, n, alpha=alpha, method=method)
        return p, lo, hi

    # Prepare data
    results = []
    for m in metrics:
        if m == 'overall':
            # overall share of *all* papers that are non vs participatory
            p_non, lo_non, hi_non = prop_and_ci(k_overall_non,  n_total)
            p_par, lo_par, hi_par = prop_and_ci(k_overall_part, n_total)
            n_non_this, k_non_this = n_total, k_overall_non
            n_par_this, k_par_this = n_total, k_overall_part
        else:
            p_non, lo_non, hi_non = prop_and_ci(k_non[m],  n_non)
            p_par, lo_par, hi_par = prop_and_ci(k_part[m], n_part)
            n_non_this, k_non_this = n_non,  k_non[m]
            n_par_this, k_par_this = n_part, k_part[m]

        results.append({
            'metric': m,
            'non': {'p': p_non, 'lo': lo_non, 'hi': hi_non, 'n': n_non_this, 'k': k_non_this},
            'par': {'p': p_par, 'lo': lo_par, 'hi': hi_par, 'n': n_par_this, 'k': k_par_this}
        })

    # Plot
    fig, ax = plt.subplots(figsize=(8.5, 4.8))


    #Shade the "Overall" panel (from left margin to the midpoint between Overall and Sensitivity)
    # With xticks at 0,1,2,3 the midpoint is 0.5, so this shades only the Overall column.
    ax.axvspan(-0.5, 0.5, color='0.95', zorder=0)

    # Keep the separator line as well
    ax.axvline(x=0.5, color='0.6', linestyle='--', linewidth=1.2, zorder=1)

    x = np.arange(len(results))
    offset = 0.18 

    # Plot dots + vertical 95% CI bars
    for i, r in enumerate(results):
        if r['metric'] == 'overall':
            # Plot points only (no error bars)
            ax.plot(x[i] - offset, r['non']['p'], 'o',
                    color=col_non, markersize=6)
            ax.plot(x[i] + offset, r['par']['p'], 'o',
                    color=col_par, markersize=6)
        else:
            # Non-participatory (blue)
            ax.errorbar(
                x[i] - offset, r['non']['p'],
                yerr=[[r['non']['p'] - r['non']['lo']],
                      [r['non']['hi'] - r['non']['p']]],
                fmt='o', color=col_non, ecolor=col_non,
                elinewidth=1.2, capsize=3, markersize=6
            )

            # Participatory (red)
            ax.errorbar(
                x[i] + offset, r['par']['p'],
                yerr=[[r['par']['p'] - r['par']['lo']],
                      [r['par']['hi'] - r['par']['p']]],
                fmt='o', color=col_par, ecolor=col_par,
                elinewidth=1.2, capsize=3, markersize=6)

    # X/Y formatting
    ax.set_xticks(x)
    ax.set_xticklabels([{'overall':'Overall','sensitivity':'Sensitivity analysis','calibration':'Calibration','validation':'Validation'}[r['metric']] for r in results])
    ax.set_xlim(-0.5, len(results)-0.5)   # add margins so separator is visible
    ax.set_ylim(0, 1)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, pos: f"{int(round(v*100))}%"))
    ax.set_ylabel("Proportion of papers (95% CI)")
    ax.grid(axis='y', linestyle=':', alpha=0.5)

    # Separator line between Overall and Sensitivity
    # It will appear between the first and second tick (x = 0.5)
    ax.axvline(x=0.5, color='0.6', linestyle='--', linewidth=1.2)

    # Legend
    h_non = ax.plot([], [], 'o', color=col_non, label='Non-participatory')[0]
    h_par = ax.plot([], [], 'o', color=col_par, label='Participatory')[0]
    ax.legend(handles=[h_non, h_par], frameon=False, loc='lower right')

    save_figure("PM_evaluation")

def plot_decision_method_evaluation_dotplot():
    method_df = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["decision_method"])

    n_rule = int(
        method_df.loc[
            method_df["Decision method"] == "Rule",
            "Count"
        ].iloc[0])

    n_theory = int(
        method_df.loc[
            method_df["Decision method"] == "Theory",
            "Count"
        ].iloc[0])

    n_other = int(
        method_df.loc[
            method_df["Decision method"] == "Other",
            "Count"
        ].iloc[0])

    n_total = n_rule + n_theory + n_other
    
    # Load evaluation counts
    eval_df = pd.read_excel(
        xlsx,
        sheet_name=SHEETS["decision_evaluation"])

    k_rule = dict(
        zip(
            eval_df["Evaluation"]
            .str.strip()
            .str.lower(),
            eval_df["Rule"]))

    k_theory = dict(
        zip(
            eval_df["Evaluation"]
            .str.strip()
            .str.lower(),
            eval_df["Theory"]))

    k_other = dict(
        zip(
            eval_df["Evaluation"]
            .str.strip()
            .str.lower(),
            eval_df["Other"]))

    # X-axis order (put Overall first)
    metrics = ['overall', 'sensitivity', 'calibration', 'validation']
    labels  = ['Overall', 'Sensitivity analysis', 'Calibration', 'Validation']

    # Colors
    col_rule   = '#56B4E9'  
    col_theory = '#D55E00'  
    col_other  = '#009E73' 
    col_map = {'Rule': col_rule,'Theory': col_theory,'Other': col_other}

    # Method order & denominators
    methods = ['Rule', 'Theory', 'Other']
    n_by_method = {
        'Rule': n_rule,
        'Theory': n_theory,
        'Other': n_other}
    k_by_method = {
        'Rule': k_rule,
        'Theory': k_theory,
        'Other': k_other}
    
    # Helper: Wilson 95% CI for a proportion
    def prop_wilson_ci(k, n, alpha=0.05):
        p = k / n if n > 0 else np.nan
        lo, hi = proportion_confint(k, n, alpha=alpha, method='wilson') if n > 0 else (np.nan, np.nan)
        return p, lo, hi


    # Prep plotting
    fig, ax = plt.subplots(figsize=(8.8, 5.2))
    x = np.arange(len(metrics))

    # after: fig, ax = plt.subplots(...)
    # before (or after) plotting the dots
    left, right = -0.5, 0.5  

    # Draw the grey span above the axes facecolor but *below* grid & markers
    ax.axvspan(left, right, facecolor='0.95', edgecolor='none', zorder=0.5)

    # Separator at the right edge of the Overall column
    ax.axvline(right, color='0.6', ls='--', lw=1.2, zorder=0.8)

    # Make sure the x-limits encompass the span exactly
    ax.set_xlim(-0.5, len(metrics) - 0.5)

    # Draw the grid above the shade but below the dots
    ax.set_axisbelow(True)
    ax.grid(axis='y', linestyle=':', alpha=0.5, zorder=1.0)

    # Symmetric offsets so the three methods are split at each tick
    offset = 0.18
    offsets = {
        'Rule': -offset,
        'Theory':       0.00,
        'Other':       +offset}

    # Plot
    for i, metric in enumerate(metrics):

        if metric == 'overall':
            # Plot points only (no error bars) at Overall, one per method
            for m in methods:
                p_overall = n_by_method[m] / n_total  # share of corpus in that method
                ax.plot(
                    x[i] + offsets[m], p_overall,
                    marker='o', color=col_map[m], markersize=6
                )

        else:
            # Plot dot + 95% Wilson CI per method for Sens/Cal/Val
            for m in methods:
                n = n_by_method[m]
                k = k_by_method[m][metric]
                p, lo, hi = prop_wilson_ci(k, n, alpha=0.05)
                ax.errorbar(
                    x[i] + offsets[m], p,
                    yerr=[[p - lo], [hi - p]],
                    fmt='o', color=col_map[m], ecolor=col_map[m],
                    elinewidth=1.2, capsize=3, markersize=6
                )

    # Axes, legend, cosmetics
    ax.set_xticks(x)
    ax.set_xticklabels(labels)
    ax.set_ylim(0, 1)
    ax.yaxis.set_major_formatter(FuncFormatter(lambda v, pos: f"{int(round(v*100))}%"))
    ax.set_ylabel("Proportion of papers (95% CI)")
    ax.grid(axis='y', linestyle=':', alpha=0.5)

    # Legend
    handles = [
        Line2D([0],[0], marker='o', color='w', markerfacecolor=col_map[m], label=m, markersize=7)
        for m in methods
    ]
    ax.legend(handles=handles, frameon=False, loc='upper right', title="Decision method")

    save_figure("decision_method_evaluation")

